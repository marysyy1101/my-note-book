{
  "name": "jizhang",
  "version": "1.0.0",
  "private": true,
  "description": "Taro + 微信云开发 记账小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass",
    "framework": "React"
  },
  "scripts": {
    "postinstall": "node scripts/patch-taro-raf.mjs",
    "build:weapp": "node scripts/patch-taro-raf.mjs && taro build --type weapp && node scripts/check-dist.mjs",
    "dev:weapp": "node scripts/patch-taro-raf.mjs && taro build --type weapp --watch",
    "icons": "node scripts/gen-icons.mjs",
    "patch:raf": "node scripts/patch-taro-raf.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "browserslist": [
    "ios >= 9",
    "android >= 4.4",
    "chrome >= 53"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.3.2",
    "@tarojs/taro-loader": "4.3.2",
    "@tarojs/webpack5-runner": "4.3.2",
    "@types/node": "^18",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.3.2",
    "lucide-static": "^0.454.0",
    "postcss": "^8.5.6",
    "sass": "^1.75.0",
    "sharp": "^0.33.5",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "webpack": "5.91.0"
  }
}
